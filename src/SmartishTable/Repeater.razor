@using Microsoft.AspNetCore.Components.Web.Virtualization
@if (Virtualize != null && Virtualize(Root))
{
  <Virtualize Items="@Root.DisplayList" Context="item" SpacerElement="@SpacerElement" OverscanCount="@OverscanCount" ItemSize="@ItemSize" @attributes="AdditionalAttributes">
    <ItemContent>
      @{
        var context = new RepeaterContext<SmartishTItem>()
        {
          Item = item,
          Index = -1 // Index is not available in Virtualize, so we set it to -1 or you can implement a different logic to track the index if needed
        };
        @RowTemplate(context)
      }
    </ItemContent>
  </Virtualize>
}
else if (Root.DisplayList != null && Root.DisplayList.Count > 0)
{
  @for (int i = 0; i < Root.DisplayList.Count; i++)
  {
    var context = new RepeaterContext<SmartishTItem>()
    {
      Item = Root.DisplayList[i],
      Index = i
    };
    @RowTemplate(context)
  }
}
else
{
  if (EmptyTemplate != null)
  {
    @EmptyTemplate
  }
}

@typeparam SmartishTItem
@code {
  [CascadingParameter(Name = "SmartishTableRoot")]
  public Root<SmartishTItem> Root { get; set; } = default!;

  [Parameter]
  public RenderFragment<RepeaterContext<SmartishTItem>> RowTemplate { get; set; } = default!;

  [Parameter]
  public RenderFragment? EmptyTemplate { get; set; }

  /// <summary>
  /// Used with Virtualization, default 50
  /// </summary>
  [Parameter] public float ItemSize { get; set; } = 50;
  /// <summary>
  /// Used with Virtualization, default 3.
  /// </summary>
  [Parameter] public int OverscanCount { get; set; } = 3;
  /// <summary>
  /// Used with Virtualization
  /// </summary>
  [Parameter] public string? SpacerElement { get; set; }

  /// <summary>
  /// Additional attributes for Virtualization component.
  /// </summary>
  [Parameter(CaptureUnmatchedValues = true)]
  public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

  /// <summary>
  /// Determines whether to use Virtualize or not. If this function returns true, Virtualize will be used; otherwise, the standard rendering will be used.
  /// Index is not available in Virtualize, so we set it to -1 or you can implement a different logic to track the index if needed
  /// </summary>
  [Parameter]
  public Func<Root<SmartishTItem>, bool>? Virtualize { get; set; }
}
